NODE_ENV=development
APP_NAME=saas-pos
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000/api/v1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_pos?schema=public
DB_POOL_MIN=2
DB_POOL_MAX=10

JWT_SECRET=replace-with-a-strong-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-strong-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=replace-with-a-session-secret
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
INSTALLATION_SECRET=replace-with-a-one-time-secret-at-least-32-characters
PRIVATE_STORAGE_PATH=apps/api/var/private
KYB_DOCUMENT_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

ENCRYPTION_KEY=replace-with-a-secure-32-byte-key
CORS_ORIGINS=http://localhost:5173
HELMET_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

REDIS_URL=redis://localhost:6379
QUEUE_NAME=saas-pos
JOB_RETRY_LIMIT=3

LOG_LEVEL=info
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PAYMENT_PROVIDER_API_KEY=
AI_PROVIDER_API_KEY=
SENTRY_DSN=
